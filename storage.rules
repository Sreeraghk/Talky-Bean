rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'jruhO3mtqrcBDUxJ2CuPJhs2clf1' ||
        (request.auth.token != null && (request.auth.token.email == 'sreeraghk@gmail.com' || request.auth.token.email.lower() == 'sreeraghk@gmail.com'))
      );
    }

    function isValidFileSize() {
      return request.resource.size < 25 * 1024 * 1024; // 25 MB max
    }

    function isAllowedContentType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('text/.*') ||
             request.resource.contentType == 'application/pdf' ||
             request.resource.contentType == 'application/octet-stream';
    }

    // User-specific upload directory: /{folder}/{userId}/{fileName}
    // Ensures strictly private user isolation (users cannot read or modify other users' files)
    match /{folder}/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidFileSize() && isAllowedContentType();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Default lockdown for any other paths
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
