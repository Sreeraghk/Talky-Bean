# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional server-side model override. Defaults to "gemini-flash-latest".
# Supported flash models: "gemini-flash-latest", "gemini-3.8-flash", "gemini-3.1-flash-lite".
# Changing this environment variable updates the preferred model without requiring code changes.
GEMINI_MODEL="gemini-flash-latest"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DODO PAYMENTS CONFIGURATION (SERVER-ONLY SECRETS)
# CRITICAL SECURITY MANDATE: Do NOT add VITE_ prefix to these secrets!
# These keys must remain strictly on the Express backend / Cloud Run runtime.
DODO_PAYMENTS_API_KEY="YOUR_DODO_PAYMENTS_API_KEY"
DODO_PAYMENTS_WEBHOOK_SECRET="YOUR_DODO_PAYMENTS_WEBHOOK_SECRET"
DODO_PAYMENTS_ENVIRONMENT="test_mode" # "test_mode" or "live_mode"

# REVENUECAT CONFIGURATION (MOBILE IN-APP PURCHASES)
# Client Public API Keys (safe for Capacitor client bundles)
VITE_REVENUECAT_GOOGLE_API_KEY="goog_YOUR_REVENUECAT_GOOGLE_KEY"
VITE_REVENUECAT_APPLE_API_KEY="appl_YOUR_REVENUECAT_APPLE_KEY"

# Server Secrets (Cloud Run / Express backend only - NO VITE_ PREFIX!)
REVENUECAT_SECRET_KEY="sk_YOUR_REVENUECAT_SECRET_API_KEY"
REVENUECAT_WEBHOOK_AUTH_TOKEN="YOUR_REVENUECAT_WEBHOOK_AUTH_TOKEN"

# PROXY & AI TOKEN BUDGET / SPEND-CAP CONFIGURATION (SERVER-ONLY, OPTIONAL)
# TRUST_PROXY_HOPS: Number of trusted reverse-proxy hops (e.g. 1 for Cloud Run / Render)
TRUST_PROXY_HOPS="1"

# Global bankruptcy-proof kill switch across ALL users + guests combined
MAX_DAILY_GLOBAL_TOKENS="5000000"
MAX_MONTHLY_GLOBAL_TOKENS="80000000"

# Authenticated learner allowances (generous for heavy daily study)
AI_USER_DAILY_TOKEN_LIMIT="250000"
AI_USER_MONTHLY_TOKEN_LIMIT="4000000"
AI_USER_WINDOW_TOKEN_LIMIT="45000"
AI_ADMIN_DAILY_TOKEN_LIMIT="1000000"

# Unauthenticated guest allowances (strict per-IP caps)
AI_GUEST_DAILY_TOKEN_LIMIT="30000"
AI_GUEST_MONTHLY_TOKEN_LIMIT="150000"
AI_GUEST_WINDOW_TOKEN_LIMIT="12000"
AI_GUEST_DAILY_REQUEST_LIMIT="40"

# Per-request safety ceilings
AI_MAX_INPUT_TOKENS_USER="24000"
AI_MAX_INPUT_TOKENS_GUEST="8000"
AI_MAX_OUTPUT_TOKENS_STANDARD="4096"
AI_MAX_OUTPUT_TOKENS_LONG_FORM="8192"
AI_MAX_OUTPUT_TOKENS_GUEST="2048"
