# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional server-side model override. Defaults to "gemini-flash-latest".
# Supported flash models: "gemini-flash-latest", "gemini-3.8-flash", "gemini-3.1-flash-lite".
# Changing this environment variable updates the preferred model without requiring code changes.
GEMINI_MODEL="gemini-flash-latest"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DODO PAYMENTS CONFIGURATION (SERVER-ONLY SECRETS)
# CRITICAL SECURITY MANDATE: Do NOT add VITE_ prefix to these secrets!
# These keys must remain strictly on the Express backend / Cloud Run runtime.
DODO_PAYMENTS_API_KEY="YOUR_DODO_PAYMENTS_API_KEY"
DODO_PAYMENTS_WEBHOOK_SECRET="YOUR_DODO_PAYMENTS_WEBHOOK_SECRET"
DODO_PAYMENTS_ENVIRONMENT="test_mode" # "test_mode" or "live_mode"

# REVENUECAT CONFIGURATION (MOBILE IN-APP PURCHASES)
# Client Public API Keys (safe for Capacitor client bundles)
VITE_REVENUECAT_GOOGLE_API_KEY="goog_YOUR_REVENUECAT_GOOGLE_KEY"
VITE_REVENUECAT_APPLE_API_KEY="appl_YOUR_REVENUECAT_APPLE_KEY"

# Server Secrets (Cloud Run / Express backend only - NO VITE_ PREFIX!)
REVENUECAT_SECRET_KEY="sk_YOUR_REVENUECAT_SECRET_API_KEY"
REVENUECAT_WEBHOOK_AUTH_TOKEN="YOUR_REVENUECAT_WEBHOOK_AUTH_TOKEN"
